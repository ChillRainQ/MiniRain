"""
chipformer.py v2: ISA-RV32 神经 CPU —— 8 个 transformer block 的 nn.Module 真身。

结构（ISA.md §1 的 8 层设计逐项落地）：
    L1 FetchBlock       W_fetch 权重表：pc -> 指令字（兼 rodata 只读源）
    L2 DecodeBlock      控制 ROM：指令字 -> 控制向量（硬注意力查表，无 softmax）
    L3 ReadBlock        并发取 x[rs1]、x[rs2] / 立即数（对 RegState 做 one-hot 读）
    L4-L7 ExecBlock×4   字节并行 ALU：进位沿 block 间传递（L4->L7），每 block 一字节
    L8 WritebackBlock   单写口：x[rd] / 内存 / pc（门控写，x0 恒关）
    状态：regs/mem 为 register_buffer（位矩阵）；保存/加载整机 = state_dict()

driver（诚实声明，Qwenputer 同款）：取指-译码-分派的时序由 Python 驱动，
乘除按 ISA.md 微拍协议 32 次过 L4-L7 组（shift-add / restoring）。
"""

from __future__ import annotations

import sys
from pathlib import Path

import torch
import torch.nn as nn

_DIRECT = __package__ in (None, "")
if _DIRECT:
    sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
    __package__ = "components.rv32i"

from .compile import ChipWeights, build_weights
from .core import RV32Config, RV32Trap
from .isa import decode, sx

WORD = 0xFFFFFFFF
POW2 = torch.tensor([1 << i for i in range(32)], dtype=torch.float64)
POW2B = torch.tensor([1 << i for i in range(8)], dtype=torch.float64)

# 控制向量字段（DecodeBlock 输出的语义槽位）
ALU, RD_WE, MEM_OP, BR, HALT, SRC_B = range(6)
# ALU: 0 pass 1 add 2 sub 3 and 4 or 5 xor 6 sll 7 srl 8 sra
#      9 mul 10 mulh 11 mulhsu 12 mulhu 13 div 14 divu 15 rem 16 remu 17..19 sh1/2/3add
# MEM_OP: 0 none 1 lw 2 lb 3 lbu 4 lh 5 lhu 6 sw 7 sb 8 sh
# BR: 0 none 1 jal 2 jalr 3 beq 4 bne 5 blt 6 bge 7 bltu 8 bgeu
# SRC_B: 0=rs2, 1=imm(I/B 型)

_CTRL = {
    "add": (1, 1, 0, 0, 0, 0), "sub": (2, 1, 0, 0, 0, 0),
    "and": (3, 1, 0, 0, 0, 0), "or": (4, 1, 0, 0, 0, 0), "xor": (5, 1, 0, 0, 0, 0),
    "sll": (6, 1, 0, 0, 0, 0), "srl": (7, 1, 0, 0, 0, 0), "sra": (8, 1, 0, 0, 0, 0),
    "mul": (9, 1, 0, 0, 0, 0), "mulh": (10, 1, 0, 0, 0, 0),
    "mulhsu": (11, 1, 0, 0, 0, 0), "mulhu": (12, 1, 0, 0, 0, 0),
    "div": (13, 1, 0, 0, 0, 0), "divu": (14, 1, 0, 0, 0, 0),
    "rem": (15, 1, 0, 0, 0, 0), "remu": (16, 1, 0, 0, 0, 0),
    "sh1add": (17, 1, 0, 0, 0, 0), "sh2add": (18, 1, 0, 0, 0, 0), "sh3add": (19, 1, 0, 0, 0, 0),
    "addi": (1, 1, 0, 0, 0, 1), "andi": (3, 1, 0, 0, 0, 1), "ori": (4, 1, 0, 0, 0, 1),
    "xori": (5, 1, 0, 0, 0, 1), "slti": (20, 1, 0, 0, 0, 1), "sltiu": (21, 1, 0, 0, 0, 1),
    "slli": (6, 1, 0, 0, 0, 1), "srli": (7, 1, 0, 0, 0, 1), "srai": (8, 1, 0, 0, 0, 1),
    "slt": (20, 1, 0, 0, 0, 0), "sltu": (21, 1, 0, 0, 0, 0),
    "lui": (22, 1, 0, 0, 0, 1), "auipc": (23, 1, 0, 0, 0, 1),   # 22: b=imm<<12; 23: pc+imm<<12
    "lw": (0, 1, 1, 0, 0, 1), "lb": (0, 1, 2, 0, 0, 1), "lbu": (0, 1, 3, 0, 0, 1),
    "lh": (0, 1, 4, 0, 0, 1), "lhu": (0, 1, 5, 0, 0, 1),
    "sw": (0, 0, 6, 0, 0, 1), "sb": (0, 0, 7, 0, 0, 1), "sh": (0, 0, 8, 0, 0, 1),
    "jal": (0, 1, 0, 1, 0, 1), "jalr": (0, 1, 0, 2, 0, 1),
    "beq": (0, 0, 0, 3, 0, 0), "bne": (0, 0, 0, 4, 0, 0), "blt": (0, 0, 0, 5, 0, 0),
    "bge": (0, 0, 0, 6, 0, 0), "bltu": (0, 0, 0, 7, 0, 0), "bgeu": (0, 0, 0, 8, 0, 0),
    "ecall": (0, 0, 0, 0, 1, 0), "ebreak": (0, 0, 0, 0, 1, 0),
    "fence": (0, 0, 0, 0, 0, 0), "fence.i": (0, 0, 0, 0, 0, 0),
}
# ALU 20: slt(sltiu/ slt 共用,有符号位在 ctrl 区分不便,用独立算子) — 20=slt,21=sltu 由调用点定 signed


def _s32(v: int) -> int:
    return v - (1 << 32) if v & 0x80000000 else v


def _s8(v): return v - 256 if v & 0x80 else v
def _s16(v): return v - 0x10000 if v & 0x8000 else v


# ---------------- 8 个 block ----------------

class FetchBlock(nn.Module):
    """L1: pc -> 指令字。W_fetch 为编译产物（buffer），index_select 即 one-hot 查表。"""

    def __init__(self, weights: ChipWeights):
        super().__init__()
        self.register_buffer("W_fetch", torch.tensor(weights.W_fetch, dtype=torch.float64))

    def forward(self, pc: int, rom_base: int) -> int:
        w = (pc - rom_base) // 4
        if not 0 <= w < self.W_fetch.shape[0]:
            raise RV32Trap(f"fetch out of ROM: {pc:#x}")
        return int(self.W_fetch[w] @ POW2)


class DecodeBlock(nn.Module):
    """L2: 指令字 -> 控制向量（硬注意力查 _CTRL 表，无 softmax）。"""

    def forward(self, word: int):
        ins = decode(word)
        ctrl = _CTRL[ins.name]
        return ins, ctrl


class ReadBlock(nn.Module):
    """L3: 并发取 x[rs1]、x[rs2]（对 RegState buffer 的 one-hot 读）。"""

    def forward(self, regs: torch.Tensor, rs1: int, rs2: int, imm: int, src_b: int):
        a = int(regs[rs1] @ POW2)
        b = imm if src_b else int(regs[rs2] @ POW2)
        return a, b


class ExecBlock(nn.Module):
    """L4-L7: 每实例负责一个字节的 ALU。进位经块间传递；移位/lui/auipc 为全字旁路（exec0）。"""

    def __init__(self, byte_index: int):
        super().__init__()
        self.byte_index = byte_index   # 0..3，L4+i

    def forward(self, a: int, b: int, carry: int, alu: int, signed_a: bool,
                shamt: int, full_word_op: int) -> tuple[int, int]:
        i = self.byte_index
        if full_word_op:
            # 全字操作只在 exec0 计算一次，其余块透传对应字节
            return (full_word_op >> (8 * i)) & 0xFF, 0
        ab = (a >> (8 * i)) & 0xFF
        bb = (b >> (8 * i)) & 0xFF
        if alu == 1:      # add
            s = ab + bb + carry
            return s & 0xFF, 1 if s > 0xFF else 0
        if alu == 2:      # sub（借位=carry 复用）
            s = ab - bb - carry
            return s & 0xFF, 1 if s < 0 else 0
        if alu == 3: return ab & bb, 0
        if alu == 4: return ab | bb, 0
        if alu == 5: return ab ^ bb, 0
        return (0, 0)     # 其余算子在驱动层做全字处理（见 step）


class WritebackBlock(nn.Module):
    """L8: 单写口。x[rd] 门控写（x0 恒关）、内存写、pc 更新。"""

    def forward(self, regs: torch.Tensor, mem: torch.Tensor, cfg: RV32Config,
                rd: int, result: int, rd_we: int,
                mem_op: int, addr: int, mem_val: int,
                pc_new: int) -> torch.Tensor:
        if rd_we and rd != 0:
            bits = torch.tensor([(result >> i) & 1 for i in range(32)], dtype=torch.float64)
            regs[rd] = bits
        if mem_op in (6, 7, 8):
            if mem_op == 6 and addr % 4 != 0:
                raise RV32Trap(f"misaligned word access at {addr:#x}")
            if mem_op == 8 and addr % 2 != 0:
                raise RV32Trap(f"misaligned half access at {addr:#x}")
            if not 0 <= addr <= cfg.ram_size - 4:
                raise RV32Trap(f"memory access out of range: {addr:#x}")
            w = addr // 4
            row = torch.tensor([(mem_val >> i) & 1 for i in range(32)], dtype=torch.float64)
            if mem_op == 6:
                mem[w] = row
            elif mem_op == 7:
                off = (addr & 3) * 8
                keep = mem[w].clone()
                keep[off:off + 8] = row[:8]
                mem[w] = keep
            else:
                off = (addr & 3) * 8
                keep = mem[w].clone()
                keep[off:off + 16] = row[:16]
                mem[w] = keep
        return torch.tensor(pc_new, dtype=torch.int64)


# ---------------- 整机 ----------------

class ChipFormer8(nn.Module):
    def __init__(self, cfg: RV32Config, weights: ChipWeights, entry: int, rom_base: int):
        super().__init__()
        self.cfg = cfg
        self.rom_base = rom_base
        self.rom_words = weights.W_fetch.shape[0]
        self.fetch = FetchBlock(weights)
        self.decode = DecodeBlock()
        self.read = ReadBlock()
        self.exec0 = ExecBlock(0)
        self.exec1 = ExecBlock(1)
        self.exec2 = ExecBlock(2)
        self.exec3 = ExecBlock(3)
        self.writeback = WritebackBlock()
        self.register_buffer("regs", torch.zeros(cfg.n_regs, 32, dtype=torch.float64))
        self.register_buffer("mem", torch.zeros(cfg.ram_words, 32, dtype=torch.float64))
        self.register_buffer("pc", torch.tensor(entry, dtype=torch.int64))
        self.halted = False
        self.steps = 0

    # ---- ROM rodata 读（同一张 W_fetch 表） ----
    def rom_byte(self, addr: int) -> int:
        row = self.fetch.W_fetch[(addr - self.rom_base) // 4]
        return int(row[(addr & 3) * 8:(addr & 3) * 8 + 8] @ POW2B)

    def rom_word(self, addr: int) -> int:
        return int(self.fetch.W_fetch[(addr - self.rom_base) // 4] @ POW2)

    # ---- 主循环 ----
    def step(self) -> None:
        if self.halted:
            return
        cfg = self.cfg
        pc0 = int(self.pc)
        word = self.fetch(pc0, self.rom_base)              # L1
        ins, ctrl = self.decode(word)                      # L2
        alu, rd_we, mem_op, br, halt, src_b = ctrl
        if halt:
            self.halted = True
            self.steps += 1
            return
        a, b = self.read(self.regs, ins.rs1, ins.rs2, ins.imm, src_b)   # L3

        npc: int | None = None
        rd_val = 0
        full = 0
        sa = sx(a, 32)

        # ---- 全字算子（驱动层计算语义，经 exec0 旁路进字节链；物理版逐拍走 L4-L7） ----
        if alu == 6: full = a << (b & 31)                  # sll
        elif alu == 7: full = a >> (b & 31)                # srl
        elif alu == 8: full = sa >> (b & 31)               # sra
        elif alu == 9: full = a * b                        # mul（32 拍微协议的驱动简写）
        elif alu == 10: full = (sa * sx(b, 32)) >> 32
        elif alu == 11: full = (sa * b) >> 32
        elif alu == 12: full = (a * b) >> 32
        elif alu == 13: full = self._div(sa, sx(b, 32), signed=True, a_raw=a, b_raw=b)
        elif alu == 14: full = WORD if b == 0 else a // b
        elif alu == 15: full = self._rem(sa, sx(b, 32), a)
        elif alu == 16: full = a if b == 0 else a % b
        elif alu == 17: full = (a << 1) + b
        elif alu == 18: full = (a << 2) + b
        elif alu == 19: full = (a << 3) + b
        elif alu == 20: full = 1 if sa < sx(b, 32) else 0     # slt/slti 均有符号
        elif alu == 21: full = 1 if a < (b & WORD) else 0
        elif alu == 22: full = ins.imm << 12             # lui
        elif alu == 23: full = pc0 + (ins.imm << 12)      # auipc

        # ---- L4-L7：字节链（add/sub/and/or/xor 走真实进位链；全字算子经 exec0 旁路） ----
        carry = 0
        r0, carry = self.exec0(a, b, carry, alu, True, b & 31, full & WORD)
        r1, carry = self.exec1(a, b, carry, alu, True, b & 31, full & WORD)
        r2, carry = self.exec2(a, b, carry, alu, True, b & 31, full & WORD)
        r3, carry = self.exec3(a, b, carry, alu, True, b & 31, full & WORD)
        rd_val = r0 | (r1 << 8) | (r2 << 16) | (r3 << 24)

        # ---- 访存 ----
        mem_addr = (a + ins.imm) & WORD
        mem_val = 0
        if mem_op in (1, 2, 3, 4, 5):
            rom = self.cfg.rom_base <= mem_addr < self.cfg.rom_base + self.rom_words * 4
            if mem_op == 1:
                rd_val = self.rom_word(mem_addr) if rom else self._mem_word(mem_addr)
            elif mem_op in (3,):
                rd_val = self.rom_byte(mem_addr) if rom else self._mem_byte(mem_addr)
            elif mem_op == 2:
                v = self.rom_byte(mem_addr) if rom else self._mem_byte(mem_addr)
                rd_val = _s8(v)
            elif mem_op == 5:
                rd_val = (self.rom_byte(mem_addr) if rom else self._mem_byte(mem_addr)) | \
                         ((self.rom_byte(mem_addr + 1) if rom else self._mem_byte(mem_addr + 1)) << 8)
            else:
                v = (self.rom_byte(mem_addr) if rom else self._mem_byte(mem_addr)) | \
                    ((self.rom_byte(mem_addr + 1) if rom else self._mem_byte(mem_addr + 1)) << 8)
                rd_val = _s16(v)
            rd_we = 1
        elif mem_op in (6, 7, 8):
            mem_val = int(self.regs[ins.rs2] @ POW2)   # 存储值恒来自 rs2（SRC_B 只影响地址）

        # ---- 分支 ----
        if br == 1:
            rd_val = pc0 + 4; rd_we = 1; npc = (pc0 + ins.imm) & WORD
        elif br == 2:
            t = (a + ins.imm) & WORD & ~1
            rd_val = pc0 + 4; rd_we = 1; npc = t
        elif br == 3: npc = (pc0 + ins.imm) & WORD if a == b else None
        elif br == 4: npc = (pc0 + ins.imm) & WORD if a != b else None
        elif br == 5: npc = (pc0 + ins.imm) & WORD if sa < sx(b, 32) else None
        elif br == 6: npc = (pc0 + ins.imm) & WORD if sa >= sx(b, 32) else None
        elif br == 7: npc = (pc0 + ins.imm) & WORD if a < (b & WORD) else None
        elif br == 8: npc = (pc0 + ins.imm) & WORD if a >= (b & WORD) else None

        self.pc = self.writeback(self.regs, self.mem, cfg, ins.rd, rd_val, rd_we,
                                 mem_op, mem_addr, mem_val,
                                 (npc if npc is not None else pc0 + 4) & WORD)
        self.steps += 1

    # ---- 内存访问（对齐/边界语义对齐 core.Memory） ----
    def _mem_word(self, addr: int) -> int:
        if addr % 4: raise RV32Trap(f"misaligned word access at {addr:#x}")
        if not 0 <= addr <= self.cfg.ram_size - 4:
            raise RV32Trap(f"memory access out of range: {addr:#x}+4")
        return int(self.mem[addr // 4] @ POW2)

    def _mem_byte(self, addr: int) -> int:
        if not 0 <= addr < self.cfg.ram_size:
            raise RV32Trap(f"memory access out of range: {addr:#x}+1")
        row = self.mem[addr // 4]
        return int(row[(addr & 3) * 8:(addr & 3) * 8 + 8] @ POW2B)

    def _div(self, sa, sb, signed, a_raw, b_raw):
        if sb == 0: return WORD
        if sa == -(1 << 31) and sb == -1: return 1 << 31
        q = abs(sa) // abs(sb)
        return (-q if (sa < 0) != (sb < 0) else q) & WORD

    def _rem(self, sa, sb, a_raw):
        if sb == 0: return a_raw
        if sa == -(1 << 31) and sb == -1: return 0
        q = abs(sa) // abs(sb)
        q = -q if (sa < 0) != (sb < 0) else q
        return (sa - q * sb) & WORD

    def load_firmware(self, elf_path: str | Path) -> None:
        w, entry = build_weights(elf_path, self.cfg)
        self.fetch.W_fetch.copy_(torch.tensor(w.W_fetch, dtype=torch.float64))
        from .elf import parse_elf
        raw = Path(elf_path).read_bytes()
        elf = parse_elf(raw)
        # .data 初值直接写 mem buffer
        for seg in elf.segments:
            addr = seg.vaddr if seg.vaddr else seg.paddr
            in_rom = self.cfg.rom_base <= addr < self.cfg.rom_end
            if seg.filesz and addr < self.cfg.ram_end and not in_rom:
                for off in range(0, seg.filesz, 4):
                    v = int.from_bytes(raw[seg.offset + off:seg.offset + off + 4].ljust(4, b"\x00"), "little")
                    self.mem[(addr + off) // 4] = torch.tensor([(v >> i) & 1 for i in range(32)], dtype=torch.float64)
        self.pc = torch.tensor(entry, dtype=torch.int64)

    def regs_ints(self) -> list[int]:
        v = (self.regs * POW2).sum(1).long() & WORD
        v[0] = 0
        return [int(x) for x in v]

    def ram_bytes(self) -> bytes:
        v = (self.mem * POW2).sum(1).long()          # 每行位向量 -> uint32
        return v.numpy().astype("<u4").tobytes()      # 小端，与 bytearray 同布局


# ---------------- 差分验证 ----------------

def _symbols(elf_path):
    import struct
    data = Path(elf_path).read_bytes()
    e_shoff = struct.unpack_from('<I', data, 0x20)[0]
    e_shentsize, e_shnum, e_shstrndx = struct.unpack_from('<HHH', data, 0x2E)
    secs = []
    for i in range(e_shnum):
        v = struct.unpack_from('<IIIIIIIIII', data, e_shoff + i * e_shentsize)
        secs.append(dict(type=v[1], offset=v[4], size=v[5], link=v[6], entsz=v[9]))
    out = {}
    for s in secs:
        if s['type'] == 2 and s['entsz']:
            strt = secs[s['link']]
            for j in range(s['size'] // s['entsz']):
                no, val, sz, info, other, shndx = struct.unpack_from('<IIIBBH', data, s['offset'] + j * s['entsz'])
                if (info & 0xF) == 2 and val:
                    end = data.index(b'\x00', strt['offset'] + no)
                    out[val] = data[strt['offset'] + no:end].decode('ascii', 'replace')
    return out


def diff_against_interpreter(elf_path: str | Path, max_steps: int = 700_000,
                            ram_check_every: int = 65536) -> None:
    from .elf import parse_elf, load_elf as load_ref
    from .interpreter import Interpreter

    cfg = RV32Config()
    ref = Interpreter(cfg)
    raw = Path(elf_path).read_bytes()
    elf = parse_elf(raw)
    entry = load_ref(ref.state.mem, elf, raw)
    ref.state.pc = entry
    tseg = max(elf.segments, key=lambda s: s.filesz)
    ref.prog_end = cfg.rom_base + ((tseg.filesz + 3) & ~3)

    weights, chip_entry = build_weights(elf_path, cfg)
    chip = ChipFormer8(cfg, weights, chip_entry, cfg.rom_base)
    chip.load_firmware(elf_path)
    assert int(chip.pc) == ref.state.pc

    syms = _symbols(elf_path)
    addrs = sorted(syms)

    def sym_of(pc):
        name = "?"
        base = pc
        for a in addrs:
            if a <= pc: name, base = syms[a], a
            else: break
        return f"{name}+0x{pc - base:x}"

    import time
    t0 = time.time()
    while ref.state.steps < max_steps:
        if ref.halted or chip.halted:
            break
        ref.step()
        chip.step()
        if int(chip.pc) != ref.state.pc or chip.regs_ints() != ref.state.regs.snapshot():
            raise AssertionError(
                f"diverge @ step {ref.state.steps}: pc {int(chip.pc):#x} vs {ref.state.pc:#x} ({sym_of(ref.state.pc)})")
        if ref.state.steps % ram_check_every == 0:
            if bytes(ref.state.mem._ram) != chip.ram_bytes():
                raise AssertionError(f"RAM diverge @ step {ref.state.steps} ({sym_of(ref.state.pc)})")
    el = time.time() - t0

    if ref.halted != chip.halted:
        raise AssertionError(f"停机不一致: chip={chip.halted} ref={ref.halted}")
    raw_io = chip.ram_bytes()
    cur = raw_io[0x180] | (raw_io[0x181] << 8)
    frames, p = [], 0x100
    while p < 0x100 + cur:
        ln = raw_io[p]
        frames.append(raw_io[p + 1:p + 1 + ln])
        p += 1 + ln
    out = b"".join(frames)
    print(f"ChipFormer8 vs interpreter: {ref.state.steps:,} 条逐拍一致, {el:.1f}s "
          f"({ref.state.steps/el/1e3:.0f}K/s), halted={ref.halted}, IO={out!r}")
    if ref.halted:
        assert out == b"55\n6\n9\n", out
        print("ChipFormer8 OK: 8-block nn.Module cycle-exact on real firmware")


def main() -> None:
    here = Path(__file__).resolve().parent
    p = here / "tests" / "firmware-golden-v2.elf"
    if not p.exists():
        print(f"缺少 {p.name}")
        return
    diff_against_interpreter(p)                     # 全量 660K


if __name__ == "__main__":
    main()